<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EXOKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EXOKit"
    xmlns:services="using:EXOKit.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EXOKit">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout" Padding="0" RequestedTheme="Dark" Background="{ThemeResource ShellCanvasBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#101010" />
                        <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0A0A0A" />
                        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#EDEDED" />
                        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#EDEDED" />
                        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D4D4D4" />
                        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#B0B0B0" />
                        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0A0A0A" />
                        <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#333333" />
                        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#EDEDED" />
                        <StaticResource x:Key="AccentButtonBackground" ResourceKey="AccentFillColorDefaultBrush" />
                        <StaticResource x:Key="AccentButtonBackgroundPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="AccentButtonBackgroundPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                        <StaticResource x:Key="AccentButtonForeground" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="AccentFillColorDefaultBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="AccentFillColorDefaultBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="AccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="AccentFillColorTertiaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
                        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="TextOnAccentFillColorSecondaryBrush" />
                        <StaticResource x:Key="PivotHeaderItemSelectedPipeFill" ResourceKey="AccentFillColorDefaultBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button x:Name="ButtonCancelOperation" Grid.Row="1" Content="Cancel Remaining Work" Visibility="Collapsed"
                HorizontalAlignment="Right" Margin="12" Click="ButtonCancelOperation_Click" />

        <!-- Sidebar navigation (full height) + section content -->
        <NavigationView Grid.Row="0" x:Name="MainNavigationView"
                        PaneDisplayMode="Auto" OpenPaneLength="232" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="1120"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneTitle="EXOKit"
                        IsTitleBarAutoPaddingEnabled="False" SelectionChanged="MainNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavItemMailboxes" Content="Mailboxes" Tag="Mailboxes" Icon="Mail" IsSelected="True" />
                    <NavigationViewItem x:Name="NavItemCreateMailbox" Content="Create Mailbox" Tag="CreateMailbox" Icon="Add" />
                    <NavigationViewItem x:Name="NavItemResources" Content="Resources" Tag="Resources" Icon="Library" />
                    <NavigationViewItem x:Name="NavItemGroups" Content="Groups" Tag="Groups" Icon="People" />
                    <NavigationViewItem x:Name="NavItemCreateGroup" Content="Create Group" Tag="CreateGroup" Icon="AddFriend" />
                    <NavigationViewItem x:Name="NavItemGroupSettings" Content="Group Settings" Tag="GroupSettings" Icon="Manage" />
                    <NavigationViewItem x:Name="NavItemBookings" Content="Bookings" Tag="Bookings" Icon="Calendar" />
                    <NavigationViewItemSeparator />
                    <NavigationViewItem x:Name="NavItemRecipientLookup" Content="Recipient Lookup" Tag="RecipientLookup" Icon="Find" />
                    <NavigationViewItem x:Name="NavItemReporting" Content="Reporting" Tag="Reporting" Icon="Page" />
                    <NavigationViewItem x:Name="NavItemSnapshots" Content="Snapshots" Tag="Snapshots" Icon="Clock" />
                    <NavigationViewItem x:Name="NavItemSettings" Content="Settings" Tag="Settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <Grid x:Name="WorkspaceGrid" Padding="24,20,24,12" SizeChanged="WorkspaceGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="OutputRow" Height="220" />
                </Grid.RowDefinitions>

                <!-- Connection status bar -->
                <Border x:Name="ConnectionBar" Grid.Row="0" BorderBrush="{ThemeResource ShellBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TextBlockPageTitle" Text="Mailboxes" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <ProgressRing Grid.Column="1" x:Name="ShellOperationProgress" Width="20" Height="20" IsActive="False"
                                          Visibility="Collapsed" AutomationProperties.Name="Operation in progress" />
                        </Grid>
                        <StackPanel x:Name="ConnectionControls" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                    Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel x:Name="ExoConnectionStatus" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="8" Height="8">
                                    <Ellipse x:Name="ExoOfflineIndicator" Stroke="{ThemeResource ShellMutedBrush}" StrokeThickness="1" />
                                    <Ellipse x:Name="ExoOnlineIndicator" Fill="{ThemeResource ShellConnectedBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="TextBlockExoStatus" Text="EXO offline" FontSize="12" Foreground="{ThemeResource ShellMutedBrush}" />
                            </StackPanel>
                            <StackPanel x:Name="GraphConnectionStatus" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Grid Width="8" Height="8">
                                    <Ellipse x:Name="GraphOfflineIndicator" Stroke="{ThemeResource ShellMutedBrush}" StrokeThickness="1" />
                                    <Ellipse x:Name="GraphOnlineIndicator" Fill="{ThemeResource ShellConnectedBrush}" Visibility="Collapsed" />
                                </Grid>
                                <TextBlock x:Name="TextBlockGraphStatus" Text="Graph offline" FontSize="12" Foreground="{ThemeResource ShellMutedBrush}" />
                            </StackPanel>
                            <Button x:Name="ButtonConnections" Width="32" Height="32" Padding="6" Background="Transparent"
                                    ToolTipService.ToolTip="Manage connections" AutomationProperties.Name="Manage connections">
                                <SymbolIcon Symbol="World" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="ButtonConnectExo" Text="Connect Exchange Online" Icon="Mail" Click="ButtonConnectExo_Click" />
                                        <MenuFlyoutItem x:Name="ButtonConnectGraph" Text="Connect Microsoft Graph" Icon="People" Click="ButtonConnectGraph_Click" IsEnabled="False" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="ButtonDisconnect" Text="Disconnect All" Icon="Cancel" Click="ButtonDisconnect_Click" IsEnabled="False" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="OperationPanels" Grid.Row="1">
                <!-- Mailboxes -->
                <ScrollViewer x:Name="PanelMailboxes" Visibility="Visible">
                    <Grid ColumnSpacing="24" Padding="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                            <TextBlock Text="Mailbox(es) (one per line, or comma/semicolon separated)" Opacity="0.85" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TextBoxSharedMailboxes" AcceptsReturn="True" Height="140" HorizontalAlignment="Stretch" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="Browse..." Click="ButtonBrowseSharedMailboxes_Click" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                            <TextBlock Text="Users" Opacity="0.85" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="TextBoxMailboxUsers" AcceptsReturn="True" Height="140" HorizontalAlignment="Stretch" TextWrapping="Wrap" />
                                <Button Grid.Column="1" Content="Browse..." Click="ButtonBrowseMailboxUsers_Click" VerticalAlignment="Top" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="12" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox x:Name="CheckBoxFullAccess" Content="Full Access" />
                                <CheckBox x:Name="CheckBoxSendAs" Content="Send As" />
                                <CheckBox x:Name="CheckBoxSendOnBehalf" Content="Send on Behalf" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ButtonAddMailboxPermissions" Content="Add Permissions" Click="ButtonAddMailboxPermissions_Click" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="ButtonRemoveMailboxPermissions" Content="Remove Permissions" Click="ButtonRemoveMailboxPermissions_Click" />
                                <Button x:Name="ButtonValidateMailboxes" Content="Validate Input" Click="ButtonValidateMailboxes_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Create Mailbox -->
                <ScrollViewer x:Name="PanelCreateMailbox" Visibility="Collapsed">
                    <StackPanel Spacing="8" Padding="8">
                        <TextBlock Text="Create New Shared Mailbox" FontWeight="SemiBold" FontSize="16" />

                        <TextBlock Text="Display Name" />
                        <TextBox x:Name="TextBoxNewMbDisplayName" Width="420" HorizontalAlignment="Left" />

                        <TextBlock Text="Email Address" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="TextBoxNewMbAlias" Width="200" />
                            <TextBlock Text="@" VerticalAlignment="Center" />
                            <ComboBox x:Name="ComboBoxNewMbDomain" Width="216" PlaceholderText="Select domain..." />
                            <Button x:Name="ButtonRefreshDomains" Content="Refresh" Click="ButtonRefreshDomains_Click" VerticalAlignment="Stretch" />
                        </StackPanel>

                        <TextBlock Text="Department (optional)" />
                        <TextBox x:Name="TextBoxNewMbDepartment" Width="420" HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="CheckBoxNewMbArchive" Content="Enable Archive Mailbox" />
                            <CheckBox x:Name="CheckBoxNewMbHideFromGal" Content="Hide From Address Lists" />
                        </StackPanel>

                        <TextBlock Text="Delivery Restrictions (optional)" FontWeight="SemiBold" />
                        <CheckBox x:Name="CheckBoxNewMbRequireAuth" Content="Require Sender Authentication (reject external senders by default)" />
                        <TextBlock Text="Accept Messages Only From (blank = accept all)" />
                        <TextBox x:Name="TextBoxNewMbAcceptedSenders" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock Text="Reject Messages From" />
                        <TextBox x:Name="TextBoxNewMbBlockedSenders" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />

                        <TextBlock Text="Initial Delegation (optional)" FontWeight="SemiBold" />
                        <TextBlock Text="Full Access" />
                        <TextBox x:Name="TextBoxNewMbFullAccess" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock Text="Send As" />
                        <TextBox x:Name="TextBoxNewMbSendAs" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                        <TextBlock Text="Send on Behalf" />
                        <TextBox x:Name="TextBoxNewMbSendOnBehalf" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />

                        <Button x:Name="ButtonCreateSharedMailbox" Content="Create Shared Mailbox" Click="ButtonCreateSharedMailbox_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Resources -->
                <ScrollViewer x:Name="PanelResources" Visibility="Collapsed">
                    <StackPanel Spacing="8" Padding="8">
                        <TextBlock Text="Resource Mailboxes (Room/Equipment)" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TextBoxResourceMailboxes" AcceptsReturn="True" Height="80" Width="420" TextWrapping="Wrap" />
                            <Button Content="Browse..." Click="ButtonBrowseResourceMailboxes_Click" VerticalAlignment="Top" />
                        </StackPanel>
                        <TextBlock Text="Users" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TextBoxResourceUsers" AcceptsReturn="True" Height="80" Width="420" TextWrapping="Wrap" />
                            <Button Content="Browse..." Click="ButtonBrowseResourceUsers_Click" VerticalAlignment="Top" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="CheckBoxResourceFullAccess" Content="Full Access" />
                            <CheckBox x:Name="CheckBoxResourceSendAs" Content="Send As" />
                            <CheckBox x:Name="CheckBoxResourceSendOnBehalf" Content="Send on Behalf" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ButtonAddResourcePermissions" Content="Add Permissions" Click="ButtonAddResourcePermissions_Click" />
                            <Button x:Name="ButtonRemoveResourcePermissions" Content="Remove Permissions" Click="ButtonRemoveResourcePermissions_Click" />
                            <Button x:Name="ButtonValidateResources" Content="Validate Input" Click="ButtonValidateResources_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Groups -->
                <ScrollViewer x:Name="PanelGroups" Visibility="Collapsed">
                    <StackPanel Spacing="8" Padding="8">
                        <TextBlock Text="Distribution Groups / M365 Groups" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TextBoxGroups" AcceptsReturn="True" Height="80" Width="420" TextWrapping="Wrap" />
                            <Button Content="Browse..." Click="ButtonBrowseGroups_Click" VerticalAlignment="Top" />
                        </StackPanel>
                        <TextBlock Text="Users" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TextBoxGroupUsers" AcceptsReturn="True" Height="80" Width="420" TextWrapping="Wrap" />
                            <Button Content="Browse..." Click="ButtonBrowseGroupUsers_Click" VerticalAlignment="Top" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="CheckBoxMember" Content="Member" />
                            <CheckBox x:Name="CheckBoxOwner" Content="Owner" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ButtonAddMembership" Content="Add Role" Click="ButtonAddMembership_Click" />
                            <Button x:Name="ButtonRemoveMembership" Content="Remove Role" Click="ButtonRemoveMembership_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Create Group -->
                <ScrollViewer x:Name="PanelCreateGroup" Visibility="Collapsed">
                    <StackPanel Spacing="8" Padding="8">
                        <TextBlock Text="Create New Group" FontWeight="SemiBold" FontSize="16" />

                        <TextBlock Text="Group Type" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton x:Name="RadioNewGroupM365" Content="Microsoft 365 Group" GroupName="NewGroupType" IsChecked="True" Checked="RadioNewGroupType_Checked" />
                            <RadioButton x:Name="RadioNewGroupDistribution" Content="Distribution Group" GroupName="NewGroupType" Checked="RadioNewGroupType_Checked" />
                            <RadioButton x:Name="RadioNewGroupSecurity" Content="Mail-Enabled Security Group" GroupName="NewGroupType" Checked="RadioNewGroupType_Checked" />
                        </StackPanel>

                        <TextBlock Text="Display Name" />
                        <TextBox x:Name="TextBoxNewGroupDisplayName" Width="420" HorizontalAlignment="Left" />

                        <TextBlock Text="Email Address" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="TextBoxNewGroupAlias" Width="200" />
                            <TextBlock Text="@" VerticalAlignment="Center" />
                            <ComboBox x:Name="ComboBoxNewGroupDomain" Width="216" PlaceholderText="Select domain..." />
                            <Button x:Name="ButtonRefreshGroupDomains" Content="Refresh" Click="ButtonRefreshGroupDomains_Click" VerticalAlignment="Stretch" />
                        </StackPanel>

                        <TextBlock x:Name="TextBlockNewGroupPrivacyLabel" Text="Privacy (Microsoft 365 Groups only)" />
                        <StackPanel x:Name="PanelNewGroupPrivacy" Orientation="Horizontal" Spacing="16">
                            <RadioButton x:Name="RadioNewGroupPublic" Content="Public" GroupName="NewGroupPrivacy" IsChecked="True" />
                            <RadioButton x:Name="RadioNewGroupPrivate" Content="Private" GroupName="NewGroupPrivacy" />
                        </StackPanel>

                        <StackPanel x:Name="PanelNewGroupTeams" Spacing="4">
                            <TextBlock Text="Add Microsoft Teams to your group" FontWeight="SemiBold" />
                            <CheckBox x:Name="CheckBoxNewGroupCreateTeam" Content="Create a team for this group" />
                        </StackPanel>

                        <StackPanel x:Name="PanelNewGroupCommunication" Spacing="4">
                            <TextBlock Text="Communication" FontWeight="SemiBold" />
                            <CheckBox x:Name="CheckBoxNewGroupAllowExternalSenders" Content="Allow people outside of my organization to send email to this group" />
                        </StackPanel>

                        <StackPanel x:Name="PanelNewGroupJoinLeave" Spacing="8">
                            <TextBlock Text="Joining the group" FontWeight="SemiBold" />
                            <StackPanel Spacing="4">
                                <RadioButton x:Name="RadioNewGroupJoinOpen" GroupName="NewGroupJoin" IsChecked="True" Content="Open (Anyone can join this group without owner approval)" />
                                <RadioButton x:Name="RadioNewGroupJoinClosed" GroupName="NewGroupJoin" Content="Closed (Only group owners can add members. All requests to join will be automatically declined)" />
                                <RadioButton x:Name="RadioNewGroupJoinApproval" GroupName="NewGroupJoin" Content="Owner approval (Anyone can request to join this group and owners must approve the request)" />
                            </StackPanel>
                            <TextBlock Text="Leaving the group" FontWeight="SemiBold" />
                            <StackPanel Spacing="4">
                                <RadioButton x:Name="RadioNewGroupLeaveOpen" GroupName="NewGroupLeave" IsChecked="True" Content="Open (Anyone can leave this group without group owner approval)" />
                                <RadioButton x:Name="RadioNewGroupLeaveClosed" GroupName="NewGroupLeave" Content="Closed (Only group owners can remove members. All requests to leave will be automatically declined)" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelNewGroupApproval" Spacing="4">
                            <TextBlock Text="Approval" FontWeight="SemiBold" />
                            <CheckBox x:Name="CheckBoxNewGroupRequireApproval" Content="Require owner approval to join the group" />
                        </StackPanel>

                        <TextBlock Text="Owner (required, at least one user)" />
                        <TextBox x:Name="TextBoxNewGroupOwner" Width="420" HorizontalAlignment="Left" />

                        <TextBlock Text="Initial Members (optional, one per line, or comma/semicolon separated)" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TextBoxNewGroupMembers" AcceptsReturn="True" Height="80" Width="420" TextWrapping="Wrap" />
                            <Button Content="Browse..." Click="ButtonBrowseNewGroupMembers_Click" VerticalAlignment="Top" />
                        </StackPanel>

                        <Button x:Name="ButtonCreateGroup" Content="Create Group" Click="ButtonCreateGroup_Click" />
                        <TextBox x:Name="TextBoxExistingTeamGroup" Header="Existing Microsoft 365 Group Email or ID" />
                        <Button Content="Resume Team Provisioning" Click="ButtonResumeTeam_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Group Settings (Distribution Groups only) -->
                <ScrollViewer x:Name="PanelGroupSettings" Visibility="Collapsed">
                    <StackPanel Spacing="12" Padding="8">
                        <TextBlock Text="Group Settings (Distribution Groups / Mail-Enabled Security Groups)" FontWeight="SemiBold" FontSize="16" />

                        <TextBlock Text="Group Identity" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TextBoxGroupSettingsIdentity" Width="420" HorizontalAlignment="Left" />
                            <Button x:Name="ButtonLoadGroupSettings" Content="Load Settings" Click="ButtonLoadGroupSettings_Click" />
                        </StackPanel>

                        <!-- Delivery management -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Delivery management" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Sender options" FontWeight="SemiBold" />
                                <StackPanel Spacing="4">
                                    <RadioButton x:Name="RadioDeliveryInternalOnly" GroupName="DeliverySenderOptions" IsChecked="True" Content="Only allow messages from people inside my organization" />
                                    <RadioButton x:Name="RadioDeliveryInternalAndExternal" GroupName="DeliverySenderOptions" Content="Allow messages from people inside and outside my organization" />
                                </StackPanel>
                                <TextBlock Text="Specified senders (optional; restricts senders to only these users/groups)" />
                                <TextBox x:Name="TextBoxDeliverySpecifiedSenders" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <Button x:Name="ButtonSaveDeliveryManagement" Content="Save Delivery Management" Click="ButtonSaveDeliveryManagement_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Manage delegates -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Manage delegates" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Send As (one per line, or comma/semicolon separated)" />
                                <TextBox x:Name="TextBoxDelegatesSendAs" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <TextBlock Text="Send on Behalf (one per line, or comma/semicolon separated)" />
                                <TextBox x:Name="TextBoxDelegatesSendOnBehalf" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <Button x:Name="ButtonSaveDelegates" Content="Save Delegates" Click="ButtonSaveDelegates_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Message approval -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Message approval" FontWeight="SemiBold" FontSize="14" />
                                <CheckBox x:Name="CheckBoxRequireModeratorApproval" Content="Require moderator approval for messages sent to this group" />
                                <TextBlock Text="Group moderators" />
                                <TextBox x:Name="TextBoxModerators" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <TextBlock Text="Add senders who don't require message approval" />
                                <TextBox x:Name="TextBoxBypassModerationSenders" AcceptsReturn="True" Height="60" Width="420" TextWrapping="Wrap" HorizontalAlignment="Left" />
                                <TextBlock Text="Notify a sender if their message is not approved" FontWeight="SemiBold" />
                                <StackPanel Spacing="4">
                                    <RadioButton x:Name="RadioNotifyOnlySender" GroupName="NotifySenderMode" IsChecked="True" Content="Only sender" />
                                    <RadioButton x:Name="RadioNotifyOnlyInternal" GroupName="NotifySenderMode" Content="Only senders in your organization" />
                                    <RadioButton x:Name="RadioNotifyNever" GroupName="NotifySenderMode" Content="No notifications" />
                                </StackPanel>
                                <Button x:Name="ButtonSaveMessageApproval" Content="Save Message Approval" Click="ButtonSaveMessageApproval_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <!-- Membership approvals -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Membership approvals" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="Joining the group" FontWeight="SemiBold" />
                                <StackPanel Spacing="4">
                                    <RadioButton x:Name="RadioGroupSettingsJoinOpen" GroupName="GroupSettingsJoin" IsChecked="True" Content="Open (Anyone can join this group without owner approval)" />
                                    <RadioButton x:Name="RadioGroupSettingsJoinClosed" GroupName="GroupSettingsJoin" Content="Closed (Only group owners can add members. All requests to join will be automatically declined)" />
                                    <RadioButton x:Name="RadioGroupSettingsJoinApproval" GroupName="GroupSettingsJoin" Content="Owner approval (Anyone can request to join this group and owners must approve the request)" />
                                </StackPanel>
                                <TextBlock Text="Leaving the group" FontWeight="SemiBold" />
                                <StackPanel Spacing="4">
                                    <RadioButton x:Name="RadioGroupSettingsLeaveOpen" GroupName="GroupSettingsLeave" IsChecked="True" Content="Open (Anyone can leave this group without group owner approval)" />
                                    <RadioButton x:Name="RadioGroupSettingsLeaveClosed" GroupName="GroupSettingsLeave" Content="Closed (Only group owners can remove members. All requests to leave will be automatically declined)" />
                                </StackPanel>
                                <Button x:Name="ButtonSaveMembershipApproval" Content="Save Membership Approvals" Click="ButtonSaveMembershipApproval_Click" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bookings -->
                <ScrollViewer x:Name="PanelBookings" Visibility="Collapsed">
                    <StackPanel Spacing="8" Padding="8">
                        <TextBlock Text="Users to enable for Microsoft Bookings" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TextBoxBookingsUsers" AcceptsReturn="True" Height="120" Width="420" TextWrapping="Wrap" />
                            <Button Content="Browse..." Click="ButtonBrowseBookingsUsers_Click" VerticalAlignment="Top" />
                        </StackPanel>
                        <Button x:Name="ButtonEnableBookings" Content="Enable Bookings Access" Click="ButtonEnableBookings_Click" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Recipient Lookup -->
                <Grid x:Name="PanelRecipientLookup" Padding="8" RowSpacing="8" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="TextBoxRecipientCheck" Header="Recipient Identities" AcceptsReturn="True"
                             Height="112" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ToolTipService.ToolTip="One identity per line: email address, alias, display name, or object ID." />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ButtonCheckRecipient" Click="ButtonCheckRecipient_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Find" />
                                <TextBlock Text="Check Recipients" />
                            </StackPanel>
                        </Button>
                        <Button Click="ButtonBrowseRecipientIdentities_Click" ToolTipService.ToolTip="Import identities from a CSV or TXT file">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="OpenFile" />
                                <TextBlock Text="Import File" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ButtonCopyRecipientResults" Click="ButtonCopyRecipientResults_Click" Visibility="Collapsed"
                                ToolTipService.ToolTip="Copy recipient results" AutomationProperties.Name="Copy recipient results">
                            <SymbolIcon Symbol="Copy" />
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="TextBlockRecipientCheckStatus" Opacity="0.7" TextWrapping="Wrap" />
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Identity" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="Recipient Type" FontWeight="SemiBold" />
                        </Grid>
                        <ListView Grid.Row="1" x:Name="ListViewRecipientResults" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:RecipientCheckResult">
                                    <Grid Padding="0,4" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind LogMessage}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Identity}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayType}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- Reporting -->
                <Grid x:Name="PanelReporting" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="8" Padding="8">
                        <TextBlock Text="Group / Distribution List / Mailbox Identity" />
                        <TextBox x:Name="TextBoxReportingIdentity" Width="420" HorizontalAlignment="Left" TextChanged="TextBoxReportingIdentity_TextChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ButtonValidateReportingIdentity" Content="Validate" Click="ButtonValidateReportingIdentity_Click" />
                            <Button x:Name="ButtonGenerateObjectReport" Content="Generate Membership/Permissions Report" Click="ButtonGenerateObjectReport_Click" IsEnabled="False" />
                            <Button x:Name="ButtonGetMailboxDelegates" Content="Get Mailbox Delegates" Click="ButtonGetMailboxDelegates_Click" IsEnabled="False" />
                            <Button x:Name="ButtonExportReportCsv" Content="Export to CSV..." Click="ButtonExportReportCsv_Click" IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="TextBlockReportingValidation" Opacity="0.7" TextWrapping="Wrap" Text="Enter an identity and click Validate to confirm its type before running a report." />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="8,0,8,8">
                        <ListView x:Name="ListViewReportResults" SelectionMode="None">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Object" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Member / Delegate" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Role / Permission" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:ReportRow">
                                    <Grid Padding="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.2*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind ObjectName}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ObjectType}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind MemberOrDelegate}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind RoleOrPermission}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <!-- Snapshots -->
                <Grid x:Name="PanelSnapshots" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Spacing="8" Padding="8">
                        <TextBlock Text="Snapshots" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Before a destructive removal (group membership/owner or mailbox permission removal), EXOKit automatically saves a JSON snapshot of what was removed so it can be restored later." Opacity="0.7" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ButtonRefreshSnapshots" Content="Refresh" Click="ButtonRefreshSnapshots_Click" />
                            <Button x:Name="ButtonRestoreSnapshot" Content="Restore Selected" Click="ButtonRestoreSnapshot_Click" IsEnabled="False" />
                            <Button x:Name="ButtonDeleteSnapshot" Content="Delete Selected" Click="ButtonDeleteSnapshot_Click" IsEnabled="False" />
                            <Button x:Name="ButtonClearAllSnapshots" Content="Clear All" Click="ButtonClearAllSnapshots_Click" />
                            <Button x:Name="ButtonOpenSnapshotsFolder" Content="Open Snapshots Folder" Click="ButtonOpenSnapshotsFolder_Click" />
                        </StackPanel>
                        <TextBlock x:Name="TextBlockSnapshotsStatus" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Margin="8,0,8,8">
                        <ListView x:Name="ListViewSnapshots" SelectionMode="Single" SelectionChanged="ListViewSnapshots_SelectionChanged">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="0.8*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Time" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Operation" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="Description" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="3" Text="Items" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:SnapshotListItem">
                                    <Grid Padding="8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="2.4*" />
                                            <ColumnDefinition Width="0.8*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind TimestampDisplay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind OperationType}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Description}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind ItemCount}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>

                <!-- Settings -->
                <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed">
                    <StackPanel Spacing="20" Padding="8" MaxWidth="560" HorizontalAlignment="Stretch">
                        <TextBlock Text="App Settings" FontWeight="SemiBold" FontSize="16" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Connections" FontWeight="SemiBold" />
                            <CheckBox x:Name="CheckBoxExoBrowserSignIn"
                                      ToolTipService.ToolTip="Temporary workaround for WAM sign-in issues. Applies to the next EXO connection; Save Settings persists this choice.">
                                <TextBlock Text="Browser sign-in for Exchange (WAM compatibility)" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBox x:Name="TextBoxSettingsClientId" Header="EXOKit Application (Client) ID" />
                            <TextBox x:Name="TextBoxSettingsTenantId" Header="Directory (Tenant) ID" />
                            <TextBox x:Name="TextBoxSettingsGraphScopes" Header="Microsoft Graph API Scopes (one per line)"
                                     AcceptsReturn="True" Height="100" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Bookings" FontWeight="SemiBold" />
                            <TextBox x:Name="TextBoxSettingsBookingsGroup" Header="License Group Name" />
                            <TextBox x:Name="TextBoxSettingsBookingsGroupId" Header="Group Object ID (Optional)" />
                            <TextBox x:Name="TextBoxSettingsOwaPolicy" Header="Creators OWA Policy Name" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="ServiceNow Integration" FontWeight="SemiBold" />
                            <CheckBox x:Name="CheckBoxSettingsServiceNowEnabled" Content="Enabled" />
                            <TextBox x:Name="TextBoxSettingsServiceNowInstanceUrl" Header="Instance URL" />
                            <TextBox x:Name="TextBoxSettingsServiceNowKeyVaultUrl" Header="Key Vault URL" />
                            <TextBox x:Name="TextBoxSettingsServiceNowSubscriptionId" Header="Subscription ID" />
                            <TextBox x:Name="TextBoxSettingsServiceNowUsernameSecret" Header="Username Secret Name" />
                            <TextBox x:Name="TextBoxSettingsServiceNowPasswordSecret" Header="Password Secret Name" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Updates" FontWeight="SemiBold" />
                            <TextBlock x:Name="TextBlockVersion" Opacity="0.7" />
                            <TextBox x:Name="TextBoxSettingsUpdateFeed" Header="Update Feed URL (.appinstaller)" />
                            <Button Click="ButtonCheckUpdates_Click" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="Check for Updates" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <Button x:Name="ButtonSaveSettings" Click="ButtonSaveSettings_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="Save Settings" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TextBlockSettingsStatus" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="EXOKit - Exchange Admin Toolkit" Opacity="0.6" FontSize="12" />
                            <TextBlock Text="Developed by Chris Harris" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- Output: Log / Ticket Notes -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Thumb x:Name="OutputResizeHandle" Height="12" DragDelta="OutputResizeHandle_DragDelta"
                           KeyDown="OutputResizeHandle_KeyDown" IsTabStop="True" UseSystemFocusVisuals="True"
                           AutomationProperties.Name="Resize output panel"
                           ToolTipService.ToolTip="Resize output panel. Drag, or focus and use the Up and Down arrow keys.">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border Height="1" Background="{ThemeResource ShellBorderBrush}" VerticalAlignment="Center" />
                                    <Border Width="32" Height="3" Background="{ThemeResource ShellMutedBrush}" CornerRadius="1" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Grid Grid.Row="1" Margin="0,4,0,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Ticket" VerticalAlignment="Center" Foreground="{ThemeResource ShellMutedBrush}" FontSize="12" />
                            <TextBox x:Name="TextBoxServiceNowTicketNumber" Width="140" FontSize="12"
                                     AutomationProperties.Name="ServiceNow ticket number"
                                     ToolTipService.ToolTip="Optional ticket number. Verified mailbox/group role operations offer closure after you review the notes." />
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="CheckBoxShowWarnings" Content="Warnings" FontSize="12" VerticalAlignment="Center"
                                  Checked="CheckBoxShowWarnings_Changed" Unchecked="CheckBoxShowWarnings_Changed"
                                  IsChecked="True" ToolTipService.ToolTip="Show warnings, including unconfirmed changes." />
                        <Button Grid.Column="2" x:Name="ButtonToggleOutputCollapse" Click="ButtonToggleOutputCollapse_Click"
                                Width="32" Height="32" Padding="6" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="Collapse output" AutomationProperties.Name="Collapse output">
                            <FontIcon x:Name="IconToggleOutputCollapse" Glyph="&#xE70D;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Pivot Grid.Row="2" x:Name="OutputPivot">
                        <PivotItem>
                            <PivotItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Log" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TextBlockLogCount" Text="0" FontSize="12" FontFamily="Consolas"
                                               Foreground="{ThemeResource ShellMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </PivotItem.Header>
                            <Border Background="{ThemeResource ShellSurfaceBrush}" BorderThickness="0" CornerRadius="4">
                                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                                    <TextBlock x:Name="TextBlockLog" TextWrapping="Wrap" Padding="8,8,8,20" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Border>
                        </PivotItem>
                        <PivotItem>
                            <PivotItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Ticket Notes" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TextBlockTicketCount" Text="0" FontSize="12" FontFamily="Consolas"
                                               Foreground="{ThemeResource ShellMutedBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="ButtonCopyTicketNotes" Click="ButtonCopyTicketNotes_Click"
                                            Width="28" Height="28" Padding="4" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Copy last ticket notes" AutomationProperties.Name="Copy last ticket notes">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </PivotItem.Header>
                            <Border Background="{ThemeResource ShellSurfaceBrush}" BorderThickness="0" CornerRadius="4">
                                <ScrollViewer x:Name="TicketNotesScrollViewer" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                                    <TextBlock x:Name="TextBlockTicketNotes" TextWrapping="Wrap" Padding="8,8,8,20" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Border>
                        </PivotItem>
                    </Pivot>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
